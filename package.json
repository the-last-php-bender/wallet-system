{
  "name": "wallet-engine",
  "version": "1.0.0",
  "description": "High-concurrency wallet engine with NestJS-inspired modular architecture",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:prod": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:full": "powershell -NoProfile -File scripts/dev.ps1",
    "dev:quick": "powershell -NoProfile -File scripts/dev.ps1 -SkipDocker",
    "kill": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Write-Host '[+] Port 3000 freed' -ForegroundColor Green\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migrate": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:prod": "knex migrate:latest --knexfile dist/knexfile.js",
    "seed": "knex seed:run --knexfile knexfile.ts",
    "demo:init": "npm run migrate && npm run seed",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "wallet",
    "fintech",
    "payment",
    "nestjs",
    "nodejs"
  ],
  "author": "Nwinyinya David",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/opossum": "^8.1.9",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.2.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.11.0",
    "opossum": "^8.1.4",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "decimal.js": "^10.4.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.1",
    "standard": "^17.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
